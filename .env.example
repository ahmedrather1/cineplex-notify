# --- Server ---
PORT=3001
# Public URL of the deployed app (used for unsubscribe links in emails)
PUBLIC_BASE_URL=http://localhost:3001

# --- Database (Railway/Render inject DATABASE_URL when you add the Postgres addon) ---
DATABASE_URL=postgres://postgres:postgres@localhost:5432/cineplex_notify
# Set to "disable" for local Postgres without SSL
PGSSL=disable

# --- Poller ---
ENABLE_POLLER=0
POLL_INTERVAL_MINUTES=30
POLL_LOOKAHEAD_DAYS=30

# --- Email (any SMTP provider: Resend, Mailgun, SES, Mailpit locally) ---
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Cineplex Alerts <alerts@example.com>"

# --- Cineplex (public key from the website; override only if it rotates) ---
# CINEPLEX_API_KEY=
